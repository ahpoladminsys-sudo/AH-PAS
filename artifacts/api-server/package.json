{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:library-cloud-safety": "node ./test/build-library-cloud-safety.mjs && node --test ./test/.generated-library-cloud-safety.test.mjs",
    "test:library-authenticated-rebuild": "node ./test/build-library-authenticated-rebuild.mjs && node --test ./test/.generated-library-authenticated-rebuild.test.mjs",
    "test:drive-migrations": "node ./test/build-drive-migrations.mjs && node --test ./test/.generated-drive-migrations.test.mjs",
    "test:index-drive-authenticated": "node ./test/build-index-drive-authenticated.mjs && node --test ./test/.generated-index-drive-authenticated.test.mjs",
    "test:licensing-rules": "node ./test/build-licensing-rules.mjs && node --test ./test/.generated-licensing-rules.test.mjs",
    "test:licensing-audit": "esbuild ./test/licensing-audit.test.ts --bundle --platform=node --format=esm --outfile=./test/.generated-licensing-audit.test.mjs && node --test ./test/.generated-licensing-audit.test.mjs",
    "test:gemini-repair-summary": "node ./test/build-gemini-repair-summary.mjs && node --test ./test/.generated-gemini-repair-summary.test.mjs",
    "test:github-access-status": "node ./test/build-github-access-status.mjs && node --test ./test/.generated-github-access-status.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@clerk/shared": "^4.30.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
