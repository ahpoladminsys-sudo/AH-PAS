{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tinubu Stop Loss visual tokens extracted from the Stop Loss Quote & Policy Workspace. Navy anchors the underwriting workspace, teal marks active guidance and progress, mint signals cleared/positive states, gold signals review, and red is reserved for blocking risk.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4f8f9" },
      "foreground": { "$value": "#12323f" },
      "border": { "$value": "#d5e6e9" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#12323f" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#12323f" },
      "primary": { "$value": "#003648", "$description": "Deep navy for primary actions, headers, and decision emphasis." },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e6eef5" },
      "secondaryForeground": { "$value": "#123f4b" },
      "muted": { "$value": "#edf3f5" },
      "mutedForeground": { "$value": "#5c6b78" },
      "accent": { "$value": "#dcf6ec", "$description": "Mint surface for cleared, healthy, and positive workflow states." },
      "accentForeground": { "$value": "#0b5f52" },
      "destructive": { "$value": "#b5352f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c6d8dc" },
      "ring": { "$value": "#1fa0b3" },
      "chart1": { "$value": "#084c7b" },
      "chart2": { "$value": "#1fa0b3" },
      "chart3": { "$value": "#28d994" },
      "chart4": { "$value": "#d6a449" },
      "chart5": { "$value": "#b5352f" },
      "sidebar": { "$value": "#003648" },
      "sidebarForeground": { "$value": "#e8f7f8" },
      "sidebarBorder": { "$value": "#1b5363" },
      "sidebarPrimary": { "$value": "#1fa0b3" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#0c4557" },
      "sidebarAccentForeground": { "$value": "#e8f7f8" },
      "sidebarRing": { "$value": "#72d6dd" }
    },
    "dark": {
      "background": { "$value": "#0c2029" },
      "foreground": { "$value": "#e8f7f8" },
      "border": { "$value": "#244552" },
      "card": { "$value": "#102b36" },
      "cardForeground": { "$value": "#e8f7f8" },
      "popover": { "$value": "#102b36" },
      "popoverForeground": { "$value": "#e8f7f8" },
      "primary": { "$value": "#55c6d0" },
      "primaryForeground": { "$value": "#08252d" },
      "secondary": { "$value": "#1a3c48" },
      "secondaryForeground": { "$value": "#e8f7f8" },
      "muted": { "$value": "#17333e" },
      "mutedForeground": { "$value": "#a8c1c6" },
      "accent": { "$value": "#174d47" },
      "accentForeground": { "$value": "#a9f2d3" },
      "destructive": { "$value": "#d45a52" },
      "destructiveForeground": { "$value": "#1b0c0b" },
      "input": { "$value": "#2b4d58" },
      "ring": { "$value": "#72d6dd" },
      "chart1": { "$value": "#55a9d5" },
      "chart2": { "$value": "#55c6d0" },
      "chart3": { "$value": "#55d9a1" },
      "chart4": { "$value": "#e1ba63" },
      "chart5": { "$value": "#e4776e" },
      "sidebar": { "$value": "#071b24" },
      "sidebarForeground": { "$value": "#e8f7f8" },
      "sidebarBorder": { "$value": "#244552" },
      "sidebarPrimary": { "$value": "#55c6d0" },
      "sidebarPrimaryForeground": { "$value": "#08252d" },
      "sidebarAccent": { "$value": "#123640" },
      "sidebarAccentForeground": { "$value": "#e8f7f8" },
      "sidebarRing": { "$value": "#72d6dd" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Urbanist", "IBM Plex Sans", "sans-serif"], "$description": "Friendly, compact UI and body face used across the workspace." },
      "serif": { "$value": ["IBM Plex Serif", "Georgia", "serif"], "$description": "Editorial hierarchy for workspace titles and report headings." },
      "mono": { "$value": ["IBM Plex Mono", "Menlo", "monospace"], "$description": "Identifiers, rates, and audit-oriented values." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.5rem", "$description": "Compact 8px base; larger surfaces use the derived large and extra-large steps." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel rhythm used for dense underwriting forms and calm card gutters." }
  }
}